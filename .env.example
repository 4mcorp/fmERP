# 개발용 기본값 (docker-compose.dev.yml과 일치). 복사해서 .env로 사용한다.
# 운영 값은 서버의 .env에만 두고 저장소에 커밋하지 않는다.

# 앱 실행 계정 (DML만 가능)
DATABASE_URL=postgres://fmerp_app:fmerp_app_dev@localhost:55432/fmerp
# 마이그레이션 계정 (DDL)
MIGRATION_DATABASE_URL=postgres://fmerp_migrator:fmerp_migrator_dev@localhost:55432/fmerp

# 백업 전용 계정 (RLS 우회·읽기 전용, worker의 덤프·내보내기 작업용, M7)
BACKUP_DATABASE_URL=postgres://fmerp_backup:fmerp_backup_dev@localhost:55432/fmerp

# worker 헬스체크 포트
WORKER_PORT=3001

# Better Auth 전용 계정 (RLS 우회, ADR 0005)
AUTH_DATABASE_URL=postgres://fmerp_auth:fmerp_auth_dev@localhost:55432/fmerp
# 세션 서명 키 (32자 이상). 생성: openssl rand -base64 32  — 운영 값은 서버 .env에만
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-or-longer-secret
BETTER_AUTH_URL=http://localhost:3000

# 개발용 테스트 계정 로그인 (운영에서 true면 서버가 기동되지 않음). 계정: pnpm db:seed
DEV_TEST_LOGIN=true

# 파일 저장소 (개발: docker-compose.dev.yml의 SeaweedFS)
S3_ENDPOINT=http://localhost:58333
S3_REGION=us-east-1
S3_BUCKET=fmerp-dev
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_FORCE_PATH_STYLE=true
