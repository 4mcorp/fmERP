# 개발용 기본값 (docker-compose.dev.yml과 일치). 복사해서 .env로 사용한다.
# 운영 값은 서버의 .env에만 두고 저장소에 커밋하지 않는다.

# 앱 실행 계정 (DML만 가능)
DATABASE_URL=postgres://fmerp_app:fmerp_app_dev@localhost:55432/fmerp
# 마이그레이션 계정 (DDL)
MIGRATION_DATABASE_URL=postgres://fmerp_migrator:fmerp_migrator_dev@localhost:55432/fmerp

# 백업 전용 계정 (RLS 우회·읽기 전용, worker의 덤프·내보내기 작업용, M7)
BACKUP_DATABASE_URL=postgres://fmerp_backup:fmerp_backup_dev@localhost:55432/fmerp

# DB 덤프를 다룰 수 있는 시스템 관리자 이메일 (쉼표 구분, 이메일 인증된 로그인 사용자만). 비우면 덤프 기능이 꺼진다 (M7)
SYSTEM_ADMIN_EMAILS=owner@example.com

# 백업·복구 (M7): age 공개키(`age1…`, 쉼표로 여러 개). 개인키는 서버에 두지 않는다
BACKUP_AGE_RECIPIENTS=
# pg_dump·pg_restore 실행 명령 (개발 PC에서는 DB 컨테이너 안에서 실행하도록 바꿀 수 있다)
# PG_DUMP_COMMAND=docker exec -i -e PGPASSWORD=fmerp_backup_dev fmerp-dev-postgres-1 pg_dump
# BACKUP_PG_DUMP_URL=postgres://fmerp_backup:fmerp_backup_dev@localhost:5432/fmerp
# PG_RESTORE_COMMAND=docker exec -i -e PGPASSWORD=postgres fmerp-dev-postgres-1 pg_restore
# 복구 리허설이 임시 DB를 만들 수 있는 관리 연결과, pg_restore가 보는 같은 서버 주소
# REHEARSAL_ADMIN_URL=postgres://postgres:postgres@localhost:55432/postgres
# REHEARSAL_TOOL_URL=postgres://postgres:postgres@localhost:5432/postgres

# worker 헬스체크 포트
WORKER_PORT=3001

# Better Auth 전용 계정 (RLS 우회, ADR 0005)
AUTH_DATABASE_URL=postgres://fmerp_auth:fmerp_auth_dev@localhost:55432/fmerp
# 세션 서명 키 (32자 이상). 생성: openssl rand -base64 32  — 운영 값은 서버 .env에만
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-or-longer-secret
BETTER_AUTH_URL=http://localhost:3000

# 개발용 테스트 계정 로그인 (운영에서 true면 서버가 기동되지 않음). 계정: pnpm db:seed
DEV_TEST_LOGIN=true

# 파일 저장소 (개발: docker-compose.dev.yml의 SeaweedFS)
S3_ENDPOINT=http://localhost:58333
S3_REGION=us-east-1
S3_BUCKET=fmerp-dev
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_FORCE_PATH_STYLE=true
