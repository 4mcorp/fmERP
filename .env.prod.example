# 운영(prod) 환경 변수 예시. 복사해서 .env.prod로 쓰고 값을 채운다. .env.prod는 git에 넣지 않는다 (.gitignore의 .env.*).
# 값은 비워 둔다. 실제 값은 서버의 .env.prod에만 둔다. 사용법: docs/ops/prod.md

# 접속 주소: MagicDNS FQDN (Tailscale 관리 콘솔 Machines 또는 `tailscale status`에서 확인). 예: fmerp.<tailnet>.ts.net
PROD_FQDN=
# tailnet 안에서 쓰는 머신 이름 (MagicDNS 이름의 앞부분). 같은 이름이 있으면 Tailscale이 다른 이름을 붙인다
TS_HOSTNAME=fmerp
# tag:fmerp-prod 태그가 붙은 auth key (재사용 불가, 만료 짧게). 최초 기동 때만 필요하다. state 볼륨이 생긴 뒤에는 비워도 된다
TS_AUTHKEY=

# DB 비밀번호 (역할마다 다르게. 영문·숫자만 쓴다. URL에 그대로 들어간다)
POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
BACKUP_DB_PASSWORD=

# 운영 전용 버킷과 키 (스테이징·dev와 분리)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# 세션 서명 키 (32자 이상). 생성: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 시스템 관리자 이메일 (쉼표 구분). 덤프 기능을 쓰려면 필요
SYSTEM_ADMIN_EMAILS=
# age 공개키 (쉼표 구분). 개인키는 서버에 두지 않는다. worker 기동에 필요
BACKUP_AGE_RECIPIENTS=

# 선택: 텔레그램 알림. tailnet 주소는 텔레그램 서버가 닿지 못하므로 웹훅은 쓸 수 없고 폴링만 쓴다
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# 선택: 웹 푸시(홈 화면 앱 알림). 세 값을 모두 채워야 켜지며, 비우면 푸시만 꺼진다. 생성법은 docs/ops/prod.md
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
