{
  "name": "@fmerp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "backup:dump": "tsx --env-file-if-exists=../../.env src/cli/dump.ts",
    "backup:restore": "tsx --env-file-if-exists=../../.env src/cli/restore.ts",
    "backup:rehearse": "tsx --env-file-if-exists=../../.env src/cli/rehearse.ts",
    "backup:reindex": "tsx --env-file-if-exists=../../.env src/cli/reindex.ts"
  },
  "dependencies": {
    "@fmerp/backup": "workspace:*",
    "@fmerp/completion": "workspace:*",
    "@fmerp/core": "workspace:*",
    "@fmerp/db": "workspace:*",
    "@fmerp/feature-notification": "workspace:*",
    "@fmerp/storage": "workspace:*",
    "@hono/node-server": "~2.1.3",
    "@playwright/test": "~1.63.0",
    "hono": "~4.13.12",
    "pg": "~8.23.1",
    "pg-boss": "~12.35.1",
    "tsx": "~4.23.15",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@types/pg": "~8.23.1",
    "drizzle-orm": "~0.45.3"
  }
}
