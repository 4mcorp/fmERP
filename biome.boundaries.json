      "includes": [
        "features/account/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@aws-sdk/client-s3": "S3는 @fmerp/storage 어댑터(이전 후 shared/storage)로만 접근한다 (docs/rules/storage-backup.md)",
                  "@aws-sdk/s3-request-presigner": "S3는 @fmerp/storage 어댑터(이전 후 shared/storage)로만 접근한다"
                },
                "patterns": [
                  {
                    "group": [
                      "@fmerp/feature-*",
                      "!@fmerp/feature-account",
                      "!@fmerp/feature-account/*"
                    ],
                    "message": "기능 'account'은 다른 기능을 import하지 않는다. shared로 올리거나 계약+주입, 이벤트를 쓴다 (docs/plan/2026-10-06-feature-architecture-refactor.md 3.2)"
                  },
                  {
                    "group": [
                      "@fmerp/tools",
                      "@fmerp/web",
                      "@fmerp/worker"
                    ],
                    "message": "기능은 합성 루트(apps)나 도구를 import하지 않는다"
                  }
                ]
              }
            }
          }
        }
      }
