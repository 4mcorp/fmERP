# 스테이징 환경 변수 예시. 복사해서 .env.staging으로 쓰고 값을 채운다. .env.staging은 git에 넣지 않는다.
DOMAIN=example.com
# Cloudflare 대시보드의 스테이징 전용 Tunnel 토큰 (운영 Tunnel 토큰과 다른 것)
STAGING_TUNNEL_TOKEN=

# DB 비밀번호 (역할마다 다르게, 충분히 길게)
POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
BACKUP_DB_PASSWORD=

# 스테이징 전용 버킷과 키 (운영 버킷과 분리)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

BETTER_AUTH_SECRET=
SYSTEM_ADMIN_EMAILS=
# age 공개키 (개인키는 서버에 두지 않는다)
BACKUP_AGE_RECIPIENTS=

# 선택: 텔레그램 알림. 스테이징에서는 폴링을 쓰면 충분하다 (웹훅을 쓰려면 비밀 값 16자 이상)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
