{
  "name": "fmerp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fmerp/web --filter @fmerp/worker dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "pnpm --filter @fmerp/web test:e2e",
    "db:generate": "pnpm --filter @fmerp/db generate",
    "db:migrate": "pnpm --filter @fmerp/db migrate",
    "env:up": "docker compose -f docker-compose.dev.yml up -d --wait && pnpm --filter @fmerp/storage ensure-bucket",
    "env:down": "docker compose -f docker-compose.dev.yml down",
    "prepare": "lefthook install",
    "db:seed": "pnpm --filter @fmerp/auth seed",
    "backup:dump": "pnpm --filter @fmerp/worker backup:dump",
    "backup:restore": "pnpm --filter @fmerp/worker backup:restore",
    "backup:rehearse": "pnpm --filter @fmerp/worker backup:rehearse",
    "backup:reindex": "pnpm --filter @fmerp/worker backup:reindex"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@commitlint/cli": "~21.2.3",
    "@commitlint/config-conventional": "~21.2.3",
    "@types/node": "~24.19.0",
    "@vitest/coverage-v8": "~4.1.11",
    "dependency-cruiser": "~18.5.0",
    "jscpd": "~5.4.0",
    "knip": "~6.39.0",
    "lefthook": "~2.1.16",
    "tsx": "~4.23.15",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11"
  }
}
